# ============================================================
#  AI SKILL DEFENSE CONSOLE — Environment Variables Template
#  Copy this file to .env and fill in every value.
#  NEVER commit .env to version control.
# ============================================================

# ------------------------------------------------------------
# APP SECURITY
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# ------------------------------------------------------------
APP_API_KEY=

# ------------------------------------------------------------
# TWILIO — Real SMS + Voice Calls
# Sign up free: https://www.twilio.com/try-twilio
#
# Step-by-step:
#  1. Log in → Console Dashboard → copy Account SID + Auth Token
#  2. Phone Numbers → Manage → Buy a Number → copy E.164 format
#  3. Voice → TwiML Apps → Create New App
#       Request URL: https://<YOUR_HOST>/api/comms/voice/twiml
#       Copy the TwiML App SID
#  4. Account → API Keys & Tokens → Create API Key (Standard)
#       Copy the SID (= API Key) and the secret shown ONCE
#  5. On your Phone Number config page set:
#       Messaging → Webhook (POST): https://<YOUR_HOST>/api/comms/webhook/sms
#       Voice    → Webhook (POST): https://<YOUR_HOST>/api/comms/webhook/voice
# ------------------------------------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
TWILIO_TWIML_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------
# FACEBOOK MESSENGER (Graph API)
# Create an app: https://developers.facebook.com/apps/
#
# Step-by-step:
#  1. Create App → Business → Add "Messenger" product
#  2. Settings → Basic → copy App ID and App Secret
#  3. Messenger → Settings → Generate Access Token for your Page
#  4. Add Webhooks → subscribe to messages, messaging_postbacks
#       Verify Token: any string you choose (set FB_WEBHOOK_VERIFY_TOKEN below)
#       Callback URL: https://<YOUR_HOST>/api/comms/webhook/fb
# ------------------------------------------------------------
FB_APP_ID=
FB_APP_SECRET=
FB_PAGE_ACCESS_TOKEN=
FB_WEBHOOK_VERIFY_TOKEN=

# ------------------------------------------------------------
# PRODUCTION URLS
# Set these so the backend knows its own public address
# (used in TwiML callback URL generation)
# ------------------------------------------------------------
PUBLIC_HOST=https://your-domain.com
ALLOWED_ORIGINS=https://your-domain.com

# ------------------------------------------------------------
# OPTIONAL: TLS / HTTPS termination (if running behind a
# reverse proxy like Caddy or Traefik, leave these empty)
# ------------------------------------------------------------
SSL_CERT_PATH=
SSL_KEY_PATH=
