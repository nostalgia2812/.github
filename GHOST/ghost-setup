#!/usr/bin/env bash
# ══════════════════════════════════════════════════════════════════════════════
# ghost-setup — Idempotent GHOST Environment Bootstrap
#
# Run this once (or re-run safely at any time) to install all tools.
#
# USAGE
#   ./ghost-setup [--all] [--recon] [--web] [--symlink] [--help]
#
# FLAGS
#   --all       Install everything (default)
#   --recon     Install recon / OSINT tools only
#   --web       Install web-dashboard tools only
#   --symlink   Install ghost-* scripts into ~/.local/bin (adds to PATH)
#   --update    Pull latest versions of already-installed tools
#   --help      Show this help
# ══════════════════════════════════════════════════════════════════════════════

set -euo pipefail

# ── Resolve GHOST root from this script's location ───────────────────────────
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
GHOST_ROOT="$SCRIPT_DIR"
LIB="$GHOST_ROOT/lib/ghost-lib.sh"

[[ -f "$LIB" ]] || { echo "[✗] lib/ghost-lib.sh not found at $LIB"; exit 1; }
source "$LIB"

# ── Flag defaults ─────────────────────────────────────────────────────────────
DO_RECON=false
DO_WEB=false
DO_SYMLINK=false
DO_UPDATE=false

parse_args() {
  if [[ $# -eq 0 ]]; then
    DO_RECON=true; DO_WEB=true; DO_SYMLINK=true
    return
  fi
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --all)     DO_RECON=true; DO_WEB=true; DO_SYMLINK=true ;;
      --recon)   DO_RECON=true ;;
      --web)     DO_WEB=true ;;
      --symlink) DO_SYMLINK=true ;;
      --update)  DO_UPDATE=true; DO_RECON=true; DO_WEB=true ;;
      --help|-h)
        grep '^#' "$0" | head -20 | sed 's/^# \?//'
        exit 0
        ;;
      *) warn "Unknown flag: $1" ;;
    esac
    shift
  done
}

parse_args "$@"

# ══════════════════════════════════════════════════════════════════════════════
ghost_banner "Setup & Bootstrap"
log "GHOST root : $GHOST_ROOT"
log "Date       : $(date)"
echo ""

# ── Create standard directory tree ───────────────────────────────────────────
hdr "Directory structure"
ghost_init_dirs
ok "Directory tree ready"
log "  $GHOST_ROOT/"
log "  ├── src/recon/"
log "  ├── src/exploit/"
log "  ├── src/web/"
log "  ├── tmp/data/"
log "  ├── tmp/logs/"
log "  └── lib/"

# ── System prerequisites ──────────────────────────────────────────────────────
hdr "System prerequisites"

MISSING=()
for cmd in git python3 pip3 curl; do
  if has_cmd "$cmd"; then
    ok "$cmd"
  else
    warn "$cmd — NOT FOUND"
    MISSING+=("$cmd")
  fi
done

if [[ ${#MISSING[@]} -gt 0 ]]; then
  echo ""
  warn "Missing prerequisites: ${MISSING[*]}"
  log "On Debian/Ubuntu:  sudo apt-get install -y git python3 python3-pip curl"
  log "On Fedora/RHEL:    sudo dnf install -y git python3 python3-pip curl"
  log "On macOS:          brew install python git curl"
  echo ""
  # Don't exit — partial install is fine
fi

# ══════════════════════════════════════════════════════════════════════════════
# RECON TOOLS
# ══════════════════════════════════════════════════════════════════════════════
if $DO_RECON; then
  hdr "Recon / OSINT tools"

  # ── Sublist3r ──────────────────────────────────────────────────────────────
  step "Sublist3r (subdomain enumeration)"
  SUBLIST3R_DIR="$GHOST_RECON/Sublist3r"

  ghost_clone "https://github.com/aboul3la/Sublist3r.git" "$SUBLIST3R_DIR"

  # Verify entry script (handles any capitalisation)
  SUBLIST3R_PY=""
  for candidate in sublist3r.py Sublist3r.py main.py; do
    if [[ -f "$SUBLIST3R_DIR/$candidate" ]]; then
      SUBLIST3R_PY="$SUBLIST3R_DIR/$candidate"
      break
    fi
  done

  if [[ -z "$SUBLIST3R_PY" ]]; then
    warn "sublist3r.py not found after clone — listing dir:"
    ls "$SUBLIST3R_DIR/" 2>/dev/null || true
    warn "Skipping Sublist3r pip install"
  else
    ok "Entry script: $SUBLIST3R_PY"
    if [[ -f "$SUBLIST3R_DIR/requirements.txt" ]]; then
      log "Installing Sublist3r Python dependencies…"
      ghost_pip_install "$SUBLIST3R_DIR/requirements.txt" \
        && ok "Sublist3r dependencies installed"
    fi

    # Write a wrapper so it's callable without cd
    SUBLIST3R_WRAPPER="$GHOST_ROOT/bin/sublist3r"
    mkdir -p "$GHOST_ROOT/bin"
    cat > "$SUBLIST3R_WRAPPER" <<WRAP
#!/usr/bin/env bash
# Auto-generated by ghost-setup — do not edit manually
exec python3 "$SUBLIST3R_PY" "\$@"
WRAP
    chmod +x "$SUBLIST3R_WRAPPER"
    ok "Wrapper: $SUBLIST3R_WRAPPER"
  fi

  # ── theHarvester ──────────────────────────────────────────────────────────
  step "theHarvester (email / host enumeration)"
  HARVESTER_DIR="$GHOST_RECON/theHarvester"
  ghost_clone "https://github.com/laramies/theHarvester.git" "$HARVESTER_DIR"
  if [[ -f "$HARVESTER_DIR/requirements/base.txt" ]]; then
    ghost_pip_install "$HARVESTER_DIR/requirements/base.txt" \
      && ok "theHarvester dependencies installed"
  elif [[ -f "$HARVESTER_DIR/requirements.txt" ]]; then
    ghost_pip_install "$HARVESTER_DIR/requirements.txt" \
      && ok "theHarvester dependencies installed"
  fi

  HARVESTER_WRAPPER="$GHOST_ROOT/bin/theharvester"
  mkdir -p "$GHOST_ROOT/bin"
  cat > "$HARVESTER_WRAPPER" <<WRAP
#!/usr/bin/env bash
# Auto-generated by ghost-setup
exec python3 "$HARVESTER_DIR/theHarvester.py" "\$@"
WRAP
  chmod +x "$HARVESTER_WRAPPER"
  ok "Wrapper: $HARVESTER_WRAPPER"

  # ── DNSrecon ──────────────────────────────────────────────────────────────
  step "dnsrecon (DNS reconnaissance)"
  DNSRECON_DIR="$GHOST_RECON/dnsrecon"
  ghost_clone "https://github.com/darkoperator/dnsrecon.git" "$DNSRECON_DIR"
  if [[ -f "$DNSRECON_DIR/requirements.txt" ]]; then
    ghost_pip_install "$DNSRECON_DIR/requirements.txt" \
      && ok "dnsrecon dependencies installed"
  fi

  DNSRECON_WRAPPER="$GHOST_ROOT/bin/dnsrecon"
  cat > "$DNSRECON_WRAPPER" <<WRAP
#!/usr/bin/env bash
exec python3 "$DNSRECON_DIR/dnsrecon.py" "\$@"
WRAP
  chmod +x "$DNSRECON_WRAPPER"
  ok "Wrapper: $DNSRECON_WRAPPER"
fi

# ══════════════════════════════════════════════════════════════════════════════
# WEB / DASHBOARD TOOLS
# ══════════════════════════════════════════════════════════════════════════════
if $DO_WEB; then
  hdr "Web / Dashboard tools"

  step "Verifying dashboard.html"
  if [[ -f "$GHOST_ROOT/dashboard.html" ]]; then
    ok "dashboard.html present"
  else
    warn "dashboard.html not found at $GHOST_ROOT/dashboard.html"
  fi

  step "Verifying ghost-start"
  if [[ -f "$GHOST_ROOT/ghost-start" ]]; then
    chmod +x "$GHOST_ROOT/ghost-start"
    ok "ghost-start executable"
  fi

  step "Verifying ghost-deploy"
  if [[ -f "$GHOST_ROOT/ghost-deploy" ]]; then
    chmod +x "$GHOST_ROOT/ghost-deploy"
    ok "ghost-deploy executable"
  fi
fi

# ══════════════════════════════════════════════════════════════════════════════
# SYMLINK INTO PATH
# ══════════════════════════════════════════════════════════════════════════════
if $DO_SYMLINK; then
  hdr "Installing GHOST scripts into PATH"

  LOCAL_BIN="$HOME/.local/bin"
  mkdir -p "$LOCAL_BIN"

  for script in ghost-start ghost-deploy ghost-setup; do
    local_src="$GHOST_ROOT/$script"
    local_link="$LOCAL_BIN/$script"
    if [[ -f "$local_src" ]]; then
      ln -sf "$local_src" "$local_link"
      ok "Linked: $local_link → $local_src"
    fi
  done

  # Also symlink bin/ wrappers (sublist3r, theharvester, etc.)
  if [[ -d "$GHOST_ROOT/bin" ]]; then
    for wrapper in "$GHOST_ROOT/bin/"*; do
      local_link="$LOCAL_BIN/$(basename "$wrapper")"
      ln -sf "$wrapper" "$local_link"
      ok "Linked: $local_link"
    done
  fi

  # PATH notice
  if ! echo "$PATH" | grep -q "$LOCAL_BIN"; then
    echo ""
    warn "$LOCAL_BIN is not in your PATH."
    log "Add the following to your ~/.bashrc or ~/.zshrc:"
    echo ""
    echo '    export PATH="$HOME/.local/bin:$PATH"'
    echo ""
    log "Then reload: source ~/.bashrc"
  else
    ok "$LOCAL_BIN is already in PATH"
  fi
fi

# ══════════════════════════════════════════════════════════════════════════════
# SUMMARY
# ══════════════════════════════════════════════════════════════════════════════
hdr "Setup complete"
echo ""
echo -e "  ${_BLD}Quick start:${_RST}"
echo "    ghost-start                   # Open dashboard in browser"
echo "    ghost-deploy local --bg       # Run dashboard as background daemon"
echo "    ghost-deploy status           # Check deployment status"
echo "    ghost-deploy docker           # Run in Docker container"
echo "    ghost-deploy pages            # Deploy to GitHub Pages"
echo ""
if $DO_RECON; then
  echo -e "  ${_BLD}Recon tools (after adding ~/.local/bin to PATH):${_RST}"
  echo "    sublist3r -d example.com -o $GHOST_DATA/subs.txt"
  echo "    theharvester -d example.com -b google"
  echo "    dnsrecon -d example.com"
  echo ""
fi
echo -e "  ${_BLD}Output directory:${_RST}  $GHOST_DATA"
echo -e "  ${_BLD}Logs directory:${_RST}    $GHOST_LOGS"
echo ""
ok "GHOST environment ready."
