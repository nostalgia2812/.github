#!/usr/bin/env bash
# ghost-start — launch the GHOST GitHub Library Dashboard
# Usage: ./ghost-start [port] [username]
#   port     (optional) port to serve on, default 8421
#   username (optional) GitHub username to pre-load, default nostalgia2812

set -euo pipefail

# ── Load shared library ───────────────────────────────────────────────────────
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/lib/ghost-lib.sh"

# ── Args ──────────────────────────────────────────────────────────────────────
PORT="${1:-8421}"
USERNAME="${2:-nostalgia2812}"
DASHBOARD="$GHOST_ROOT/dashboard.html"
URL="http://localhost:$PORT/dashboard.html"

# ── Validate ──────────────────────────────────────────────────────────────────
[[ -f "$DASHBOARD" ]] || die "dashboard.html not found at $DASHBOARD — run ghost-setup first"

if ! [[ "$PORT" =~ ^[0-9]+$ ]] || (( PORT < 1 || PORT > 65535 )); then
  die "Invalid port '$PORT'"
fi

if port_in_use "$PORT"; then
  die "Port $PORT is already in use. Choose another: ./ghost-start 9000"
fi

ghost_banner "GitHub Library Dashboard"
log "Dashboard : $DASHBOARD"
log "Username  : $USERNAME"
log "Port      : $PORT"
log "URL       : $URL"
echo ""
log "Press Ctrl+C to stop."
echo ""

# ── Patch username into a temp copy ──────────────────────────────────────────
TMP_DIR="$(mktemp -d)"
TMP_HTML="$TMP_DIR/dashboard.html"
trap 'rm -rf "$TMP_DIR"' EXIT

sed "s/value = 'nostalgia2812'/value = '$USERNAME'/" "$DASHBOARD" > "$TMP_HTML"

# ── Pick a server ─────────────────────────────────────────────────────────────
serve() {
  if has_cmd python3; then
    python3 -m http.server "$PORT" --directory "$TMP_DIR"
  elif has_cmd python; then
    (cd "$TMP_DIR" && python -m SimpleHTTPServer "$PORT")
  elif has_cmd npx; then
    npx --yes serve -l "$PORT" "$TMP_DIR"
  else
    die "No HTTP server found — install python3, python, or Node.js (npx)"
  fi
}

# ── Open browser (best-effort) ────────────────────────────────────────────────
{ sleep 0.8; open_browser "$URL"; } &

serve
